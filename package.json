{
  "name": "@ai-crew-suite/drivers",
  "description": "Drivers for the AI Crew Suite agentic workflow platform",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "22 || 24",
    "npm": "Please use Yarn instead (Corepack enable)"
  },
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*",
    "plugins/**/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:image": "yarn workspace backend build:image",
    "clean": "turbo run clean",
    "dev": "turbo run start --filter=app --filter=backend --concurrency=10",
    "lint": "turbo run lint",
    "release": "turbo run lint typecheck test:unit build && yarn dotenv -- crew publish",
    "start": "turbo start --filter=app",
    "storybook": "crew storybook",
    "storybook:build": "crew storybook:build",
    "sync": "crew sync:refs",
    "test": "yarn test:unit && yarn test:e2e && yarn test:unit:coverage",
    "test:e2e": "crew test:e2e",
    "test:unit": "turbo run test:unit",
    "test:unit:coverage": "turbo run test:unit -- --coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@backstage/cli": "catalog:dev",
    "@backstage/cli-defaults": "catalog:dev",
    "@backstage/cli-module-new": "catalog:dev",
    "@backstage/config": "catalog:dev",
    "@changesets/cli": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "@types/node": "catalog:dev",
    "husky": "catalog:dev",
    "i18next": "catalog:dev",
    "lint-staged": "catalog:dev",
    "prettier": "catalog:dev",
    "prop-types": "catalog:dev",
    "storybook": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "resolutions": {
    "@types/node": "^26.1.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "got": "11.8.6",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --config packages/config-eslint/eslint.monorepo.config.ts --fix"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
